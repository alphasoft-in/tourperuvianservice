---
import Layout from '../../layouts/Layout.astro';
import { itineraries } from '../../data/itineraries';
import { packageData } from '../../components/FeaturedPackages';
import { Clock, CheckCircle2, Map } from 'lucide-react';
import BookingActions from '../../components/BookingActions';

export function getStaticPaths() {
  const paquetesIds = packageData.filter(p => p.category === 'paquete').map(p => p.id);
  return paquetesIds.map((id) => {
    return {
      params: { id },
      props: { pkg: itineraries[id] },
    };
  });
}

const { pkg } = Astro.props;
const data = pkg.es;

const schema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": data.title,
  "description": data.subtitle || data.services.substring(0, 150) + '...',
  "touristType": [
    "Sightseeing",
    "Cultural"
  ],
  "provider": {
    "@type": "TravelAgency",
    "name": "Tour Peruvian Service",
    "url": "https://tourperuvianservice.com/"
  },
  "image": new URL(pkg.image, Astro.url).toString()
};
---

<Layout 
  title={`${data.title} | Tour Peruvian Service`}
  description={data.subtitle || data.services.substring(0, 150) + '...'}
  image={pkg.image}
  schema={schema}
>
  {/* Hero Section */}
  <div class="relative min-h-[45vh] md:min-h-[50vh] w-full pt-20 flex items-center justify-center">
    <div class="absolute inset-0 bg-black z-0">
      <img src={pkg.image} alt={data.title} width="800" height="600" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 py-8 w-full">
      <h1 class="text-2xl lg:text-4xl font-semibold text-white mb-2 lg:mb-3 drop-shadow-lg max-w-4xl leading-tight">
        {data.title.includes(': ') ? (
          <>
            <span class="block mb-1">{data.title.split(': ')[0]}:</span>
            <span class="block">{data.title.split(': ')[1]}</span>
          </>
        ) : (
          data.title
        )}
      </h1>
      <p class="text-xs lg:text-sm text-white/70 font-light max-w-2xl drop-shadow-sm mt-2 lg:mt-0">
        {data.subtitle}
      </p>
      
      <div class="mt-4 lg:mt-8 flex items-center bg-white/10 backdrop-blur-md rounded-full px-4 py-2 lg:px-6 lg:py-2.5 border border-white/20 shadow-lg">
        <Clock className="w-4 h-4 lg:w-5 lg:h-5 text-orange-400 mr-2" />
        <span class="text-xs lg:text-base text-white font-bold tracking-wide">{data.duration}</span>
      </div>
    </div>
  </div>

  {/* Content */}
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-8 md:py-12 lg:py-16 font-['Montserrat']">
    
    {/* Services */}
    <div class="bg-white rounded-3xl md:rounded-[2rem] p-5 md:p-8 lg:p-10 shadow-xl shadow-slate-200/50 border border-slate-100 mb-12 md:mb-16 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1.5 md:h-2 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500"></div>
      <h2 class="text-xl lg:text-2xl font-extrabold text-[#1E2B4D] mb-4 md:mb-6 flex flex-col md:flex-row items-center md:justify-start text-center md:text-left">
        <CheckCircle2 className="w-6 h-6 lg:w-8 lg:h-8 text-orange-500 mb-2 md:mb-0 md:mr-3 shrink-0" />
        Servicios Incluidos
      </h2>
      <p class="text-slate-600 leading-relaxed text-sm lg:text-base">{data.services}</p>
      
      {data.note && (
        <div class="mt-8 bg-orange-50 p-5 rounded-2xl border border-orange-100">
          <p class="text-sm md:text-base font-semibold text-orange-800 flex flex-col md:flex-row items-center md:justify-start text-center md:text-left">
            <span class="text-2xl md:text-xl mb-2 md:mb-0 md:mr-2">📌</span> 
            <span>Nota importante: <span class="font-normal text-orange-700 block md:inline mt-1 md:mt-0 md:ml-1">{data.note}</span></span>
          </p>
        </div>
      )}
    </div>

    {/* Timeline */}
    <div class="mb-8 lg:mb-16 text-center flex flex-col items-center">
      <div class="inline-flex items-center justify-center p-3 bg-orange-100 rounded-full mb-3 lg:mb-4">
        <Map className="w-6 h-6 lg:w-8 lg:h-8 text-orange-500" />
      </div>
      <h2 class="text-2xl lg:text-4xl font-extrabold text-[#1E2B4D]">Itinerario del Tour</h2>
    </div>
    
    <div class="relative max-w-4xl mx-auto">
      {/* Vertical Line */}
      <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-orange-500 via-orange-300 to-transparent -translate-x-1/2 z-0"></div>
      
      <div class="space-y-12">
        {data.days.map((day, index) => (
          <div class="relative flex flex-col items-center md:flex-row md:items-center w-full group">
            
            {/* Desktop Left Side (Empty for even, Card for odd) */}
            <div class="hidden md:block w-1/2 pr-8 lg:pr-12 text-right">
              {index % 2 === 0 && (
                <div class="bg-white p-5 lg:p-8 rounded-3xl shadow-lg border border-slate-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 text-left relative z-20 overflow-hidden">
                  <div class="absolute top-0 left-0 w-full h-1.5 lg:h-2 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500"></div>
                  <h3 class="font-bold text-orange-500 text-base lg:text-xl mb-3 lg:mb-5 leading-snug">{day.title}</h3>
                  <ul class="space-y-3 lg:space-y-4">
                    {day.activities.map(activity => (
                      <li class="flex items-start text-slate-600 text-sm lg:text-base">
                        <span class="w-2 h-2 rounded-full bg-orange-400 mt-1.5 lg:mt-2 mr-2 lg:mr-3 shrink-0"></span>
                        <span class="leading-relaxed">{activity}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            {/* Center Dot */}
            <div class="relative md:absolute md:left-1/2 flex items-center justify-center w-10 h-10 lg:w-12 lg:h-12 rounded-full border-4 border-white bg-orange-500 text-white font-bold shadow-md md:-translate-x-1/2 z-10 text-sm lg:text-base mb-6 md:mb-0 shrink-0">
              {index + 1}
            </div>
            
            {/* Right Side (Card for mobile always, Card for even on desktop) */}
            <div class="w-full md:pl-8 lg:pl-12 md:w-1/2">
              {(index % 2 !== 0 || true) && (
                <div class={`bg-white p-5 lg:p-8 rounded-3xl shadow-lg border border-slate-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 relative z-20 overflow-hidden ${index % 2 === 0 ? 'md:hidden' : 'block'}`}>
                  <div class="absolute top-0 left-0 w-full h-1.5 lg:h-2 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500"></div>
                  <h3 class="font-bold text-orange-500 text-base lg:text-xl mb-3 lg:mb-5 leading-snug">{day.title}</h3>
                  <ul class="space-y-3 lg:space-y-4">
                    {day.activities.map(activity => (
                      <li class="flex items-start text-slate-600 text-sm lg:text-base">
                        <span class="w-2 h-2 rounded-full bg-orange-400 mt-1.5 lg:mt-2 mr-2 lg:mr-3 shrink-0"></span>
                        <span class="leading-relaxed">{activity}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

          </div>
        ))}
      </div>
    </div>

    {/* Optional Tours */}
    {data.optionalTours && (
      <div class="mt-6 lg:mt-10 bg-slate-50 rounded-2xl p-4 lg:p-6 text-center border border-slate-100">
        <p class="text-slate-500 italic text-sm lg:text-base">✨ {data.optionalTours}</p>
      </div>
    )}

    {/* Call to Action */}
    <div class="w-full flex justify-center">
      <BookingActions client:visible tourName={data.title} language="es" />
    </div>
  </div>
</Layout>
