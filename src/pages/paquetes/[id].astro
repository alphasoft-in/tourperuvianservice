---
import Layout from '../../layouts/Layout.astro';
import { itineraries } from '../../data/itineraries';
import { Clock, CheckCircle2, Map } from 'lucide-react';

export function getStaticPaths() {
  return Object.keys(itineraries).map((id) => {
    return {
      params: { id },
      props: { pkg: itineraries[id] },
    };
  });
}

const { pkg } = Astro.props;
const data = pkg.es;
---

<Layout>
  {/* Hero Section */}
  <div class="relative min-h-[45vh] md:min-h-[50vh] w-full pt-20 flex items-center justify-center">
    <div class="absolute inset-0 bg-black z-0">
      <img src={pkg.image} alt={data.title} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 py-8 w-full">
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-3 drop-shadow-lg max-w-4xl leading-tight">
        {data.title.includes(': ') ? (
          <>
            <span class="block mb-1">{data.title.split(': ')[0]}:</span>
            <span class="block">{data.title.split(': ')[1]}</span>
          </>
        ) : (
          data.title
        )}
      </h1>
      <p class="text-xs md:text-sm text-white/70 font-light max-w-2xl drop-shadow-sm">
        {data.subtitle}
      </p>
      
      <div class="mt-6 md:mt-8 flex items-center bg-white/10 backdrop-blur-md rounded-full px-4 py-2 md:px-6 md:py-2.5 border border-white/20 shadow-lg">
        <Clock className="w-4 h-4 md:w-5 md:h-5 text-orange-400 mr-2" />
        <span class="text-xs md:text-base text-white font-bold tracking-wide">{data.duration}</span>
      </div>
    </div>
  </div>

  {/* Content */}
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-10 md:py-24 font-['Montserrat']">
    
    {/* Services */}
    <div class="bg-white rounded-3xl md:rounded-[2rem] p-5 md:p-10 shadow-xl shadow-slate-200/50 border border-slate-100 mb-16 md:mb-20 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1.5 md:h-2 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500"></div>
      <h2 class="text-xl md:text-3xl font-extrabold text-[#1E2B4D] mb-4 md:mb-6 flex flex-col md:flex-row items-center md:justify-start text-center md:text-left">
        <CheckCircle2 className="w-8 h-8 text-orange-500 mb-2 md:mb-0 md:mr-3 shrink-0" />
        Servicios Incluidos
      </h2>
      <p class="text-slate-600 leading-relaxed text-sm md:text-lg">{data.services}</p>
      
      {data.note && (
        <div class="mt-8 bg-orange-50 p-5 rounded-2xl border border-orange-100">
          <p class="text-sm md:text-base font-semibold text-orange-800 flex flex-col md:flex-row items-center md:justify-start text-center md:text-left">
            <span class="text-2xl md:text-xl mb-2 md:mb-0 md:mr-2">📌</span> 
            <span>Nota importante: <span class="font-normal text-orange-700 block md:inline mt-1 md:mt-0 md:ml-1">{data.note}</span></span>
          </p>
        </div>
      )}
    </div>

    {/* Timeline */}
    <div class="mb-10 md:mb-16 text-center flex flex-col items-center">
      <div class="inline-flex items-center justify-center p-3 bg-orange-100 rounded-full mb-3 md:mb-4">
        <Map className="w-6 h-6 md:w-8 md:h-8 text-orange-500" />
      </div>
      <h2 class="text-2xl md:text-4xl font-extrabold text-[#1E2B4D]">Itinerario del Tour</h2>
    </div>
    
    <div class="relative max-w-4xl mx-auto">
      {/* Vertical Line */}
      <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-orange-500 via-orange-300 to-transparent -translate-x-1/2 z-0"></div>
      
      <div class="space-y-12">
        {data.days.map((day, index) => (
          <div class="relative flex flex-col items-center md:flex-row md:items-center w-full group">
            
            {/* Desktop Left Side (Empty for even, Card for odd) */}
            <div class="hidden md:block w-1/2 pr-12 text-right">
              {index % 2 === 0 && (
                <div class="bg-white p-5 md:p-8 rounded-3xl shadow-lg border border-slate-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 text-left relative z-20 overflow-hidden">
                  <div class="absolute top-0 left-0 w-full h-1.5 md:h-2 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500"></div>
                  <h3 class="font-bold text-orange-500 text-base md:text-xl mb-3 md:mb-5 leading-snug">{day.title}</h3>
                  <ul class="space-y-4">
                    {day.activities.map(activity => (
                      <li class="flex items-start text-slate-600 text-sm md:text-base">
                        <span class="w-2 h-2 rounded-full bg-orange-400 mt-1.5 md:mt-2 mr-2 md:mr-3 shrink-0"></span>
                        <span class="leading-relaxed">{activity}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            {/* Center Dot */}
            <div class="relative md:absolute md:left-1/2 flex items-center justify-center w-10 h-10 md:w-12 md:h-12 rounded-full border-4 border-white bg-orange-500 text-white font-bold shadow-md md:-translate-x-1/2 z-10 text-sm md:text-base mb-6 md:mb-0 shrink-0">
              {index + 1}
            </div>
            
            {/* Right Side (Card for mobile always, Card for even on desktop) */}
            <div class="w-full md:pl-12 md:w-1/2">
              {(index % 2 !== 0 || true) && (
                <div class={`bg-white p-5 md:p-8 rounded-3xl shadow-lg border border-slate-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 relative z-20 overflow-hidden ${index % 2 === 0 ? 'md:hidden' : 'block'}`}>
                  <div class="absolute top-0 left-0 w-full h-1.5 md:h-2 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500"></div>
                  <h3 class="font-bold text-orange-500 text-base md:text-xl mb-3 md:mb-5 leading-snug">{day.title}</h3>
                  <ul class="space-y-4">
                    {day.activities.map(activity => (
                      <li class="flex items-start text-slate-600 text-sm md:text-base">
                        <span class="w-2 h-2 rounded-full bg-orange-400 mt-1.5 md:mt-2 mr-2 md:mr-3 shrink-0"></span>
                        <span class="leading-relaxed">{activity}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

          </div>
        ))}
      </div>
    </div>

    {/* Optional Tours */}
    {data.optionalTours && (
      <div class="mt-6 md:mt-10 bg-slate-50 rounded-2xl p-4 md:p-6 text-center border border-slate-100">
        <p class="text-slate-500 italic text-sm md:text-base">✨ {data.optionalTours}</p>
      </div>
    )}

    {/* Call to Action */}
    <div class="mt-6 md:mt-10 text-center">
      <a href="https://wa.me/51999999999" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 md:px-10 md:py-4 font-bold text-white rounded-full bg-gradient-to-r from-green-500 to-emerald-600 hover:shadow-lg hover:shadow-green-500/40 hover:-translate-y-1 transition-all duration-300 uppercase tracking-wider text-xs md:text-base">
        <svg class="w-4 h-4 md:w-5 md:h-5 mr-2 md:mr-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Reservar por WhatsApp
      </a>
    </div>

  </div>
</Layout>
