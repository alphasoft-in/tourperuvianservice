---
import Layout from '../layouts/Layout.astro';
import { Compass } from 'lucide-react';
---

<Layout title="404: Página no encontrada | Tour Peruvian Service">
  <section class="min-h-[80vh] flex items-center justify-center bg-slate-50 relative overflow-hidden font-['Montserrat'] px-6 pt-32 pb-20">
    <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#1e293b 1px, transparent 1px); background-size: 32px 32px;"></div>
    
    <div class="max-w-2xl w-full mx-auto text-center relative z-10">
      <div class="flex justify-center mb-6 relative">
        <div class="absolute inset-0 bg-orange-500 blur-[40px] opacity-20 rounded-full w-32 h-32 mx-auto top-1/2 -translate-y-1/2"></div>
        <div class="bg-white p-4 rounded-full shadow-xl relative">
          <Compass className="w-12 h-12 text-orange-500" />
        </div>
      </div>
      
      <h1 class="text-6xl md:text-8xl font-black text-slate-800 mb-3 tracking-tighter">
        404
      </h1>
      
      <h2 class="text-xl md:text-2xl font-bold text-slate-700 mb-4">
        Parece que te has desviado de la ruta
      </h2>
      
      <p class="text-slate-500 mb-10 text-base md:text-lg max-w-lg mx-auto leading-relaxed">
        No pudimos encontrar la página que buscas. Tal vez movimos este destino a otro lugar o escribiste la dirección incorrecta.
        <br/><br/>
        <span class="text-sm">We couldn't find the page you're looking for. It seems you've wandered off the trail.</span>
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/" 
          class="w-full sm:w-auto px-8 py-4 bg-orange-700 hover:bg-orange-800 text-white font-bold rounded-xl transition-all duration-300 shadow-lg shadow-orange-700/30 hover:shadow-orange-700/50 hover:-translate-y-1 uppercase tracking-wider text-sm flex items-center justify-center"
        >
          Ir al Inicio / Go Home
        </a>
        <a 
          href="/paquetes" 
          class="w-full sm:w-auto px-8 py-4 bg-white border-2 border-slate-200 hover:border-orange-500 text-slate-700 hover:text-orange-500 font-bold rounded-xl transition-all duration-300 uppercase tracking-wider text-sm flex items-center justify-center"
        >
          Ver Paquetes / Packages
        </a>
      </div>
    </div>
  </section>
</Layout>
